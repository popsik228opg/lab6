import java.util.Scanner;

class Sensor {
    private int value;

    public void setValue(int value) {
        this.value += value;
    }

    public int getValue() {
        return value;
    }
}

class MeasureCount {
    private int number;
    private static int total;

    public void increment() {
        number++;
        total++;
    }

    public int getNumber() {
        return number;
    }

    public static int getTotal() {
        return total;
    }
}

interface ITemperatureMeasure {
    void setValue();
    double getValue();
}

class TemperatureMeasure implements ITemperatureMeasure {
    private Sensor h;
    private MeasureCount measure = new MeasureCount();

    public TemperatureMeasure(Sensor h) {
        this.h = h;
    }

    public int getNumber() {
        return measure.getNumber();
    }

    public double getValue() {
        return measure.getNumber() == 0 ? 0 :
            (double) h.getValue() / measure.getNumber();
    }

    public void setValue() {
        Scanner scanner = new Scanner(System.in);
        measure.increment();
        System.out.print("[" + measure.getNumber() + "] = ");
        h.setValue(scanner.nextInt());
    }

    public static int getTotal() {
        return MeasureCount.getTotal();
    }
}

class ShowTemperature {
    public static void show(TemperatureMeasure t) {
        System.out.println(t.getNumber() + " = " + t.getValue() + " °C");
    }
}

public class Main {
    public static void main(String[] args) {
        TemperatureMeasure t1 = new TemperatureMeasure(new Sensor());
        TemperatureMeasure t2 = new TemperatureMeasure(new Sensor());

        for (int i = 0; i < 5; i++) {
            t1.setValue();
        }
        ShowTemperature.show(t1);

        System.out.println();

        for (int i = 0; i < 5; i++) {
            t2.setValue();
        }
        ShowTemperature.show(t2);

        System.out.println("\nTotal: " + TemperatureMeasure.getTotal());
    }
}
